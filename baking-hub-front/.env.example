# Copia este archivo a ".env". Solo lo lee el servidor de Astro (salvo las variables PUBLIC_).
# URL del backend GraphQL (backend-practica-6-2).
# Local: http://localhost:4000/   Producción (Netlify): la URL de Render, p. ej. https://baking-hub-backend.onrender.com/
GRAPHQL_URL=https://baking-hub-backend.onrender.com/
# WebSocket GraphQL usado por el servidor Astro para el panel admin.
# Local: ws://localhost:4000/subscriptions   Producción: wss://baking-hub-backend.onrender.com/subscriptions
GRAPHQL_WS_URL=wss://baking-hub-backend.onrender.com/subscriptions
# Solo en Netlify: 9000 (las funciones con streaming se cortan a los 10 s). Local: déjalo en 0 o quítalo.
# SSE_MAX_MS=9000

# Mercado Pago: clave PÚBLICA (Tus integraciones -> Credenciales; empieza con APP_USR- o TEST-). Es segura para el navegador.
# Debe corresponder al MISMO entorno que MP_ACCESS_TOKEN del backend (prueba con prueba, producción con producción).
# Se incrusta al compilar: después de cambiarla reinicia `npm run dev` (en Netlify, vuelve a desplegar).
# Déjala vacía mientras el backend esté en MP_MODO=simulado.
PUBLIC_MP_PUBLIC_KEY=APP_USR-30eaec42-8652-49e3-8aa7-73b1a362ec91